// VillageRide Sri Lanka — core database schema
// Normalized PostgreSQL schema served through Prisma ORM.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  SUPER_ADMIN
  ASSOCIATION_ADMIN
  DRIVER
  CUSTOMER
}

enum Locale {
  EN
  SI
  TA
}

enum AssociationStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum DriverStatus {
  PENDING // application started / documents incomplete
  DOCUMENTS_UNDER_REVIEW // submitted, association is verifying documents
  BACKGROUND_CHECK // documents verified, awaiting police clearance sign-off
  APPROVED
  REJECTED
  SUSPENDED // manual suspension by association/admin
  DEACTIVATED // performance-based removal (rating / cancellation thresholds)
  COMPLIANCE_HOLD // a mandatory document lapsed — auto-blocked until renewed
}

enum BackgroundCheckStatus {
  NOT_STARTED
  IN_PROGRESS
  CLEARED
  FAILED
}

/// Sri Lanka Department of Motor Traffic driving licence classes.
/// Minimum age 18 for all classes; licences are valid 8 years and require
/// theory + practical tests plus medical clearance.
enum LicenceClass {
  A1 // light motorcycle, up to 100cc
  A // motorcycle above 100cc
  B1 // motor tricycle (three-wheeler) / light van
  B // dual purpose, up to 3,500kg and 9 seats
  C1 // light lorry, 3,500–17,000kg
  C // lorry above 17,000kg
  CE // articulated vehicle / combination with trailer
  D1 // 9–33 seats
  D // bus, up to 33 seats
  DE // heavy coach combination
  G1 // hand tractor
  G // tractor / agricultural vehicle
  J // construction and loading equipment
}

enum VehicleType {
  TAXI
  THREE_WHEELER
  VAN
  MINI_VAN
  SUV
  BUS
  TRUCK
  LORRY
  DELIVERY_VEHICLE
}

/// Documents collected at driver onboarding. The regulatory ones reflect what
/// Sri Lankan law actually requires of a vehicle and driver operating for hire:
/// a DMT driving licence, an annual revenue licence (which itself requires
/// valid insurance and a Vehicle Emission Test certificate), plus identity and
/// character checks via the NIC, Sri Lanka Police and the Grama Niladhari.
enum DocumentType {
  DRIVER_LICENSE // DMT-issued driving licence
  VEHICLE_REGISTRATION // CR book
  INSURANCE // at minimum third-party liability
  VEHICLE_PHOTO
  PROFILE_PHOTO
  NATIONAL_ID // NIC
  REVENUE_LICENCE // annual; requires valid insurance + VET certificate
  VEHICLE_EMISSION_TEST // annual VET certificate
  POLICE_CLEARANCE // Sri Lanka Police clearance certificate
  GRAMA_NILADHARI_CERTIFICATE // residence + character certificate
  MEDICAL_CERTIFICATE // medical clearance (required for DMT licensing)
  VEHICLE_FITNESS_CERTIFICATE // certificate of fitness (higher-capacity vehicles)
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TripStatus {
  REQUESTED
  SEARCHING
  ACCEPTED
  DRIVER_ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_DRIVER
  NO_DRIVERS_AVAILABLE
}

/// Broad shop categories for the goods marketplace — a simple label set
/// rather than a full taxonomy table, matching how this schema treats
/// other lightweight classification fields (VehicleType, DocumentType).
enum ProductCategory {
  GROCERY
  PHARMACY
  FOOD_AND_BEVERAGE
  HOUSEHOLD
  ELECTRONICS
  CLOTHING
  OTHER
}

/// Mirrors TripStatus's shape (requested -> assigned -> in-progress ->
/// done/cancelled) since a delivery is structurally the same lifecycle as a
/// ride, just with a vendor pickup instead of a passenger and order
/// preparation steps before a driver is even needed.
enum OrderStatus {
  PLACED // just submitted, awaiting vendor confirmation
  CONFIRMED // vendor accepted the order and is preparing it
  READY_FOR_PICKUP // vendor has it ready; visible to drivers to accept
  DRIVER_ASSIGNED // a driver accepted and is heading to the vendor
  PICKED_UP // driver has the goods, en route to the customer
  DELIVERED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_VENDOR
  NO_DRIVERS_AVAILABLE
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  PAYHERE
  STRIPE
  WALLET
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum NotificationType {
  RIDE_REQUEST
  RIDE_ACCEPTED
  RIDE_CANCELLED
  DRIVER_ARRIVED
  TRIP_STARTED
  TRIP_COMPLETED
  PAYMENT_RECEIVED
  PAYMENT_SUCCESSFUL
  ASSOCIATION_ANNOUNCEMENT
  DOCUMENT_APPROVED
  DOCUMENT_REJECTED
  DOCUMENT_EXPIRING_SOON
  DOCUMENT_EXPIRED
  DRIVER_APPROVED
  DRIVER_REJECTED
  BACKGROUND_CHECK_CLEARED
  COMPLIANCE_HOLD
  PERFORMANCE_WARNING
  SYSTEM
  ORDER_PLACED
  ORDER_CONFIRMED
  ORDER_DRIVER_ASSIGNED
  ORDER_PICKED_UP
  ORDER_DELIVERED
  ORDER_CANCELLED
}

enum WalletOwnerType {
  DRIVER
  CUSTOMER
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum TransactionReason {
  TRIP_EARNING
  TRIP_PAYMENT
  WITHDRAWAL
  TOPUP
  REFUND
  COMMISSION
  PROMO_REWARD
  MEMBERSHIP_FEE
  DELIVERY_EARNING
  DELIVERY_PAYMENT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum OtpPurpose {
  LOGIN
  REGISTER
  RESET_PASSWORD
}

enum DevicePlatform {
  WEB
  ANDROID
  IOS
}

enum DiscountType {
  PERCENT
  FIXED
}

enum AnnouncementAudience {
  ALL_MEMBERS
  ALL_DRIVERS
  ALL_CUSTOMERS
}

enum ComplaintStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

// ============================================================
// IDENTITY
// ============================================================

model User {
  id              String    @id @default(cuid())
  email           String?   @unique
  phone           String?   @unique
  passwordHash    String?
  role            Role
  name            String
  avatarUrl       String?
  locale          Locale    @default(EN)
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  driverProfile      Driver?
  customerProfile    Customer?
  associationAdminOf Association[] @relation("AssociationAdmins")

  notifications   Notification[]
  deviceTokens    DeviceToken[]
  otpCodes        OtpCode[]
  auditLogs       AuditLog[]     @relation("AuditActor")
  sentMessages    ChatMessage[]  @relation("MessageSender")
  ratingsGiven    Rating[]       @relation("RatingFrom")
  ratingsReceived Rating[]       @relation("RatingTo")

  @@index([role])
}

model OtpCode {
  id          String     @id @default(cuid())
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination String // phone number or email the code was sent to
  codeHash    String
  purpose     OtpPurpose
  attempts    Int        @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([destination, purpose])
}

model DeviceToken {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String         @unique
  platform  DevicePlatform
  createdAt DateTime       @default(now())

  @@index([userId])
}

// ============================================================
// ASSOCIATIONS
// ============================================================

model Association {
  id                String            @id @default(cuid())
  name              String
  slug              String            @unique
  district          String
  address           String?
  contactPhone      String?
  contactEmail      String?
  description       String?
  logoUrl           String?
  status            AssociationStatus @default(PENDING)
  commissionPercent Decimal           @default(10) @db.Decimal(5, 2)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  admins          User[]                 @relation("AssociationAdmins")
  drivers         Driver[]
  trips           Trip[]
  pricingRules    PricingRule[]
  announcements   Announcement[]
  events          Event[]
  complaints      Complaint[]
  membershipFees  MembershipFee[]
  eligibilityRule DriverEligibilityRule?
  vendors         Vendor[]
  orders          Order[]

  @@index([status])
}

model PricingRule {
  id              String       @id @default(cuid())
  associationId   String?
  association     Association? @relation(fields: [associationId], references: [id], onDelete: Cascade)
  vehicleType     VehicleType
  baseFare        Decimal      @db.Decimal(10, 2)
  perKmRate       Decimal      @db.Decimal(10, 2)
  perMinuteRate   Decimal      @db.Decimal(10, 2)
  minimumFare     Decimal      @db.Decimal(10, 2)
  surgeMultiplier Decimal      @default(1) @db.Decimal(4, 2)
  currency        String       @default("LKR")
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([associationId, vehicleType])
}

model Announcement {
  id            String               @id @default(cuid())
  associationId String
  association   Association          @relation(fields: [associationId], references: [id], onDelete: Cascade)
  title         String
  body          String
  audience      AnnouncementAudience @default(ALL_MEMBERS)
  createdAt     DateTime             @default(now())

  @@index([associationId])
}

model Event {
  id            String      @id @default(cuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  location      String?
  startsAt      DateTime
  createdAt     DateTime    @default(now())

  @@index([associationId])
}

model MembershipFee {
  id            String      @id @default(cuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  driverId      String
  driver        Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  amount        Decimal     @db.Decimal(10, 2)
  periodMonth   Int
  periodYear    Int
  paidAt        DateTime?
  createdAt     DateTime    @default(now())

  @@unique([driverId, periodMonth, periodYear])
}

model Complaint {
  id            String          @id @default(cuid())
  associationId String
  association   Association     @relation(fields: [associationId], references: [id], onDelete: Cascade)
  driverId      String?
  driver        Driver?         @relation(fields: [driverId], references: [id], onDelete: SetNull)
  subject       String
  body          String
  status        ComplaintStatus @default(OPEN)
  createdAt     DateTime        @default(now())
  resolvedAt    DateTime?

  @@index([associationId, status])
}

// ============================================================
// DRIVERS & VEHICLES
// ============================================================

model Driver {
  id            String      @id @default(cuid())
  userId        String      @unique
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  associationId String
  association   Association @relation(fields: [associationId], references: [id])

  // --- Identity (Sri Lanka) ---
  // Nullable because they were added after the first drivers were onboarded;
  // the registration flow requires them for every new applicant.
  nicNumber   String?   @unique
  dateOfBirth DateTime?
  addressLine String?
  city        String?
  district    String?
  gnDivision  String? // Grama Niladhari division, for the character certificate

  // --- Driving licence (DMT) ---
  licenseNumber   String        @unique
  licenseExpiry   DateTime
  licenceClass    LicenceClass?
  licenceIssuedAt DateTime?

  status          DriverStatus @default(PENDING)
  isOnline        Boolean      @default(false)
  currentLat      Float?
  currentLng      Float?
  lastLocationAt  DateTime?
  ratingAvg       Decimal      @default(5) @db.Decimal(3, 2)
  totalTrips      Int          @default(0)
  approvedAt      DateTime?
  approvedById    String?
  rejectionReason String?
  joinedAt        DateTime     @default(now())

  // --- Verification pipeline ---
  submittedAt           DateTime?
  documentsVerifiedAt   DateTime?
  documentsVerifiedById String?
  backgroundCheckStatus BackgroundCheckStatus @default(NOT_STARTED)
  backgroundCheckAt     DateTime?
  backgroundCheckById   String?
  backgroundCheckNotes  String?

  // --- Performance standards (platform-set, see DriverEligibilityRule) ---
  acceptedTrips      Int       @default(0)
  cancelledTrips     Int       @default(0)
  offeredTrips       Int       @default(0)
  ratingCount        Int       @default(0)
  deactivatedAt      DateTime?
  deactivationReason String?

  // --- Compliance ---
  complianceHoldAt     DateTime?
  complianceHoldReason String?

  vehicles       Vehicle[]
  documents      Document[]
  trips          Trip[]
  orders         Order[]
  wallet         Wallet?
  membershipFees MembershipFee[]
  complaints     Complaint[]

  @@index([associationId, status])
  @@index([isOnline])
  @@index([status])
}

model Vehicle {
  id          String      @id @default(cuid())
  driverId    String
  driver      Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  type        VehicleType
  make        String
  model       String
  year        Int
  plateNumber String      @unique
  color       String
  capacity    Int
  photoUrls   String[]

  // --- Insurance (mandatory, at minimum third-party liability) ---
  insuranceExpiry   DateTime
  insurerName       String?
  insurancePolicyNo String?

  // --- Revenue licence: annual, and legally requires a valid insurance
  //     certificate plus a Vehicle Emission Test certificate to be issued. ---
  revenueLicenceNo     String?
  revenueLicenceExpiry DateTime?

  // --- Vehicle Emission Test certificate: annual. Brand-new vehicles are
  //     exempt for the first year only; reconditioned vehicles need one from
  //     year one; vehicles built before 1976 are exempt entirely. ---
  emissionTestExpiry DateTime?
  emissionTestExempt Boolean   @default(false)

  // --- Certificate of fitness: applies to higher-capacity/commercial classes ---
  fitnessCertExpiry DateTime?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  trips  Trip[]
  orders Order[]

  @@index([driverId])
  @@index([type])
}

model Document {
  id       String       @id @default(cuid())
  driverId String
  driver   Driver       @relation(fields: [driverId], references: [id], onDelete: Cascade)
  type     DocumentType
  fileUrl  String

  // Certificate/reference number and validity, so expiry can be enforced
  // automatically rather than relying on a reviewer noticing.
  documentNumber   String?
  issuingAuthority String?
  issuedAt         DateTime?
  expiresAt        DateTime?

  status          DocumentStatus @default(PENDING)
  rejectionReason String?
  uploadedAt      DateTime       @default(now())
  reviewedAt      DateTime?
  reviewedById    String?

  @@index([driverId, type])
  @@index([expiresAt])
}

/// Platform-set driver qualification thresholds. Sri Lanka has no national
/// framework governing app-based taxi operators yet (the NTC gained authority
/// over three-wheelers in June 2023, with a fuller framework expected in 2026),
/// so these are the platform's own standards — configurable per association,
/// with the global row (associationId = null) as the default.
model DriverEligibilityRule {
  id            String       @id @default(cuid())
  associationId String?      @unique
  association   Association? @relation(fields: [associationId], references: [id], onDelete: Cascade)

  minDriverAge       Int @default(18) // DMT minimum licensing age
  minLicenceYears    Int @default(1) // years held before carrying passengers
  maxVehicleAgeYears Int @default(20)

  requirePoliceClearance Boolean @default(true)
  requireGramaNiladhari  Boolean @default(true)
  requireMedicalCert     Boolean @default(true)
  requireRevenueLicence  Boolean @default(true)
  requireEmissionTest    Boolean @default(true)

  // Uber/Lyft-style performance standards
  minRating           Decimal @default(4.0) @db.Decimal(3, 2)
  maxCancellationRate Decimal @default(0.25) @db.Decimal(4, 3)
  ratingGracePeriod   Int     @default(20) // trips before rating is enforced

  expiryWarningDays Int @default(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// CUSTOMERS
// ============================================================

model Customer {
  id                   String        @id @default(cuid())
  userId               String        @unique
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultPaymentMethod PaymentMethod @default(CASH)
  favoriteDriverId     String?
  referralCode         String        @unique @default(cuid())
  createdAt            DateTime      @default(now())

  savedAddresses SavedAddress[]
  trips          Trip[]
  orders         Order[]
  wallet         Wallet?
  referralsMade  Referral[]     @relation("Referrer")
  referralsUsed  Referral?      @relation("Referee")

  @@index([userId])
}

model SavedAddress {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String
  address    String
  lat        Float
  lng        Float
  isFavorite Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model Referral {
  id              String    @id @default(cuid())
  referrerId      String
  referrer        Customer  @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeId       String    @unique
  referee         Customer  @relation("Referee", fields: [refereeId], references: [id], onDelete: Cascade)
  rewardAmount    Decimal   @db.Decimal(10, 2)
  rewardGrantedAt DateTime?
  createdAt       DateTime  @default(now())
}

model PromoCode {
  id           String       @id @default(cuid())
  code         String       @unique
  discountType DiscountType
  value        Decimal      @db.Decimal(10, 2)
  maxDiscount  Decimal?     @db.Decimal(10, 2)
  usageLimit   Int?
  usedCount    Int          @default(0)
  expiresAt    DateTime?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())

  trips Trip[]
}

// ============================================================
// TRIPS
// ============================================================

model Trip {
  id            String       @id @default(cuid())
  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id])
  driverId      String?
  driver        Driver?      @relation(fields: [driverId], references: [id])
  vehicleId     String?
  vehicle       Vehicle?     @relation(fields: [vehicleId], references: [id])
  associationId String?
  association   Association? @relation(fields: [associationId], references: [id])
  vehicleType   VehicleType

  pickupAddress  String
  pickupLat      Float
  pickupLng      Float
  dropoffAddress String
  dropoffLat     Float
  dropoffLng     Float
  distanceKm     Decimal  @db.Decimal(8, 2)
  durationMin    Int
  estimatedFare  Decimal  @db.Decimal(10, 2)
  finalFare      Decimal? @db.Decimal(10, 2)
  currency       String   @default("LKR")

  status             TripStatus    @default(REQUESTED)
  paymentMethod      PaymentMethod @default(CASH)
  paymentStatus      PaymentStatus @default(PENDING)
  cancellationReason String?
  scheduledAt        DateTime?
  isSharedRide       Boolean       @default(false)
  sosTriggered       Boolean       @default(false)

  promoCodeId String?
  promoCode   PromoCode? @relation(fields: [promoCodeId], references: [id])

  requestedAt DateTime  @default(now())
  acceptedAt  DateTime?
  arrivedAt   DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  statusEvents TripStatusEvent[]
  payments     Payment[]
  ratings      Rating[]
  chatMessages ChatMessage[]
  transactions Transaction[]

  @@index([customerId])
  @@index([driverId])
  @@index([status])
  @@index([requestedAt])
}

model TripStatusEvent {
  id        String     @id @default(cuid())
  tripId    String
  trip      Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  status    TripStatus
  note      String?
  createdAt DateTime   @default(now())

  @@index([tripId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation("MessageSender", fields: [senderId], references: [id])
  message   String
  createdAt DateTime @default(now())

  @@index([tripId])
}

model Rating {
  id         String   @id @default(cuid())
  tripId     String
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User     @relation("RatingFrom", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User     @relation("RatingTo", fields: [toUserId], references: [id])
  stars      Int
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([tripId, fromUserId])
  @@index([toUserId])
}

// ============================================================
// GOODS DELIVERY (shop / marketplace)
// ============================================================
//
// Deliberately mirrors the Trip model's shape (pickup/dropoff coordinates,
// a driver pulled from the same association's pool, the same status-machine
// pattern) rather than inventing a parallel data model — a delivery really
// is "a trip with a vendor as the pickup and a box of goods instead of a
// passenger." Vendors are onboarded by Super Admin for now rather than
// having their own login/dashboard; that's a natural phase 2 once the
// core shop -> order -> delivery loop is proven out.

model Vendor {
  id            String      @id @default(cuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id])
  name          String
  description   String?
  logoUrl       String?
  addressLine   String
  lat           Float
  lng           Float
  district      String
  contactPhone  String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())

  products Product[]
  orders   Order[]

  @@index([associationId])
  @@index([district])
}

model Product {
  id          String          @id @default(cuid())
  vendorId    String
  vendor      Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name        String
  description String?
  imageUrl    String?
  price       Decimal         @db.Decimal(10, 2)
  category    ProductCategory @default(OTHER)
  stock       Int             @default(0)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  orderItems OrderItem[]

  @@index([vendorId])
  @@index([category])
}

model Order {
  id            String       @id @default(cuid())
  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id])
  vendorId      String
  vendor        Vendor       @relation(fields: [vendorId], references: [id])
  driverId      String?
  driver        Driver?      @relation(fields: [driverId], references: [id])
  vehicleId     String?
  vehicle       Vehicle?     @relation(fields: [vehicleId], references: [id])
  associationId String?
  association   Association? @relation(fields: [associationId], references: [id])

  deliveryAddress String
  deliveryLat     Float
  deliveryLng     Float
  distanceKm      Decimal? @db.Decimal(8, 2)
  durationMin     Int?

  itemsTotal  Decimal @db.Decimal(10, 2)
  deliveryFee Decimal @db.Decimal(10, 2)
  totalAmount Decimal @db.Decimal(10, 2)
  currency    String  @default("LKR")

  status             OrderStatus   @default(PLACED)
  paymentMethod      PaymentMethod @default(CASH)
  paymentStatus      PaymentStatus @default(PENDING)
  cancellationReason String?
  notes              String?

  requestedAt      DateTime  @default(now())
  confirmedAt      DateTime?
  driverAssignedAt DateTime?
  pickedUpAt       DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?

  items        OrderItem[]
  transactions Transaction[]

  @@index([customerId])
  @@index([vendorId])
  @@index([driverId])
  @@index([associationId, status])
  @@index([requestedAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String // snapshotted at order time so a later product edit/removal doesn't rewrite history
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
}

// ============================================================
// PAYMENTS & WALLETS
// ============================================================

model Payment {
  id          String        @id @default(cuid())
  tripId      String
  trip        Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  amount      Decimal       @db.Decimal(10, 2)
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  provider    String?
  providerRef String?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  @@index([tripId])
  @@index([status])
}

model Wallet {
  id         String          @id @default(cuid())
  ownerType  WalletOwnerType
  driverId   String?         @unique
  driver     Driver?         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  customerId String?         @unique
  customer   Customer?       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  balance    Decimal         @default(0) @db.Decimal(12, 2)
  currency   String          @default("LKR")
  updatedAt  DateTime        @updatedAt
  createdAt  DateTime        @default(now())

  transactions Transaction[]
}

model Transaction {
  id        String            @id @default(cuid())
  walletId  String
  wallet    Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  tripId    String?
  trip      Trip?             @relation(fields: [tripId], references: [id])
  orderId   String?
  order     Order?            @relation(fields: [orderId], references: [id])
  type      TransactionType
  reason    TransactionReason
  amount    Decimal           @db.Decimal(12, 2)
  status    TransactionStatus @default(COMPLETED)
  createdAt DateTime          @default(now())

  @@index([walletId])
  @@index([tripId])
  @@index([orderId])
}

// ============================================================
// NOTIFICATIONS & AUDIT
// ============================================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
}
